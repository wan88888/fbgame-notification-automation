# ===== AdsPower Local API =====
# AdsPower 本地 API 地址（客户端需处于开启状态）。默认端口 50325。
ADSPOWER_API_BASE=http://local.adspower.net:50325
# 若在 AdsPower 设置里开启了 API 鉴权，填写 API Key；否则留空。
ADSPOWER_API_KEY=
# 要接管的浏览器 profile 的 user_id（在 AdsPower 里每个环境的编号）。
ADSPOWER_USER_ID=

# ===== 目标页面 =====
# Meta 游戏管理后台的入口地址。留空则使用默认（见 src/config.ts）。
META_ADMIN_URL=https://developers.facebook.com/apps/
# 具体游戏项目的名称（用于左上角项目切换）。
PROJECT_NAME=
# 单游戏兜底模式下，Send players notifications 页的固定直达 URL（可选，填了就跳过导航）。
NOTIFICATIONS_URL=
# 跳过一切导航，直接接管当前已打开的标签页（你手动开好 Send notifications 页时用）。true/false
USE_OPEN_PAGE=false

# ===== 数据来源（三选一，按优先级）=====
# 1)【推荐·运营用】campaigns 目录：放「<游戏>.csv 内容表 + <游戏>.schedule.csv 排期表」配对，自动发现。
CAMPAIGN_DIR=./campaigns
# 2)【进阶】games 配置文件（手写多游戏）。仅当 campaigns 目录没有可处理文件时才会用。
GAMES_CONFIG=./data/games.json
# 3)【单游戏兜底】上面都没有时使用。
NOTIFICATIONS_CONFIG=./data/notifications.json
CSV_FILE=./data/notifications.csv

# ===== 运行行为 =====
# 每步操作之间的放慢毫秒数（调试时调大更容易观察）。
SLOW_MO_MS=50
# 单步默认超时（毫秒）。
STEP_TIMEOUT_MS=30000
# 是否在处理完编辑后自动执行 Turn On（true/false）。
AUTO_TURN_ON=true
# 是否在上传 CSV 后停一下等待批量创建结果（毫秒）。
POST_UPLOAD_WAIT_MS=5000
# 出错时截图保存目录。
SCREENSHOT_DIR=./screenshots
# 运行结束后是否自动关闭 AdsPower 浏览器（true/false）。
CLOSE_BROWSER_ON_EXIT=false
