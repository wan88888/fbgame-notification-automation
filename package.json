{
  "name": "fbgame-notification-automation",
  "version": "1.0.0",
  "description": "Automate Meta (Facebook) game admin 'Send players notifications' workflow using Playwright + AdsPower.",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "validate": "tsx src/main.ts --validate-only",
    "gen-schedule": "tsx src/gen-schedule.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "keywords": [
    "playwright",
    "adspower",
    "automation",
    "meta",
    "facebook-game"
  ],
  "license": "MIT",
  "dependencies": {
    "csv-parse": "^7.0.1",
    "dotenv": "^16.4.5",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
