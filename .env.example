# ===== AdsPower Local API =====
# AdsPower 本地 API 地址（客户端需处于开启状态）。默认端口 50325。
ADSPOWER_API_BASE=http://local.adspower.net:50325
# 若在 AdsPower 设置里开启了 API 鉴权，填写 API Key；否则留空。
ADSPOWER_API_KEY=
# 要接管的浏览器 profile 的 user_id（在 AdsPower 里每个环境的编号）。
ADSPOWER_USER_ID=
# AdsPower 本地 API 单次请求超时（毫秒）。客户端未开启/挂起时避免永久阻塞。
ADSPOWER_API_TIMEOUT_MS=15000

# ===== 目标页面 =====
# Meta 游戏管理后台的入口地址。留空则使用默认（见 src/config.ts）。
META_ADMIN_URL=https://developers.facebook.com/apps/
# 具体游戏项目的名称（用于左上角项目切换）。
PROJECT_NAME=
# 单游戏兜底模式下，Send players notifications 页的固定直达 URL（可选，填了就跳过导航）。
NOTIFICATIONS_URL=
# 跳过一切导航，直接接管当前已打开的标签页（你手动开好 Send notifications 页时用）。true/false
USE_OPEN_PAGE=false
# campaigns 模式下，用 projects.json 里的 appId 拼「Send notifications 页」直达 URL 的模板。
# 各游戏该 URL 只有 /apps/<APP_ID>/ 这段不同，故 projects.json 通常只填 appId 即可。
# 必须含 {appId} 占位符；个别游戏 business_id 不同可在 projects.json 用整条 url 覆盖。
NOTIFICATIONS_URL_TEMPLATE=https://developers.facebook.com/apps/{appId}/use_cases/customize/user_notifications/?use_case_enum=INSTANT_GAMES_NOTIFICATION_SERVICE&business_id=644048981685643&selected_tab=user_notifications&product_route=instant-games

# ===== 数据来源（三选一，按优先级）=====
# 1)【推荐·运营用】campaigns 目录：<内容子目录>/<游戏>.csv + schedule/<游戏>.schedule.csv 配对，自动发现。
CAMPAIGN_DIR=./campaigns
# 内容表所在子目录（campaigns 下）：直接用飞书下载的「推送配置表」文件夹，无需复制或清洗。
CONTENT_SUBDIR=推送配置表
# 内容表文件名前缀：文件常叫「推送配置表 - AHA.csv」，工具推导游戏名时会剥掉此前缀
# 及紧随的分隔符（得到「AHA」），无需手工改名。文件名本身叫「AHA.csv」时不受影响。留空则不剥离。
CONTENT_NAME_PREFIX=推送配置表
# 2)【进阶】games 配置文件（手写多游戏）。仅当 campaigns 目录没有可处理文件时才会用。
GAMES_CONFIG=./data/games.json
# 3)【单游戏兜底】上面都没有时使用。
NOTIFICATIONS_CONFIG=./data/notifications.json
CSV_FILE=./data/notifications.csv

# ===== 运行行为 =====
# 每步操作之间的放慢毫秒数（调试时调大更容易观察）。
SLOW_MO_MS=50
# 单步默认超时（毫秒）。
STEP_TIMEOUT_MS=30000
# 是否在处理完编辑后自动执行 Turn On（true/false）。
AUTO_TURN_ON=true
# 上传 CSV 前先批量删除 Status=Completed 的通知，提前腾出「每 app 最多 10 条 active」名额。
# true/false，默认 false（沿用「撞到上限时才删」的懒删除兜底）。也可用命令行 --clean-first 临时打开。
DELETE_COMPLETED_BEFORE_UPLOAD=false
# 是否在上传 CSV 后停一下等待批量创建结果（毫秒）。
POST_UPLOAD_WAIT_MS=5000
# 出错时截图保存目录。
SCREENSHOT_DIR=./screenshots
# 运行日志落盘目录（每次运行写 run-<时间戳>.log，出错截图用同一时间戳前缀便于对应）。
LOG_DIR=./logs
# 运行结束后是否自动关闭 AdsPower 浏览器（true/false）。
CLOSE_BROWSER_ON_EXIT=false

# ===== 拟人化 / 防自动化检测 =====
# 拟人化总开关：随机停顿、鼠标移动、逐字符输入等，让节奏接近真人。true/false
HUMANIZE=true
# 步骤之间的随机「思考」停顿区间（毫秒）。
THINK_MIN_MS=600
THINK_MAX_MS=2200
# 逐字符键入时每个字符的随机间隔（毫秒）。
TYPE_MIN_MS=60
TYPE_MAX_MS=180
# 每条推送处理之间的随机停顿区间（毫秒）。
BETWEEN_ITEMS_MIN_MS=4000
BETWEEN_ITEMS_MAX_MS=12000
# 每个游戏之间的随机停顿区间（毫秒）。
BETWEEN_GAMES_MIN_MS=15000
BETWEEN_GAMES_MAX_MS=45000
# 频率闸门：单次运行最多处理多少条推送（跨所有游戏累计）。0=不限制。
MAX_ITEMS_PER_RUN=0
# 是否总是主动设置 Send Time Strategy。后台默认即为 Predicted Best Time，
# 目标策略是该默认值时会自动跳过这一步（少一次易碎交互）；设 true 可强制每条都主动设置。
ALWAYS_SET_STRATEGY=false

# ===== 断点续跑 =====
# 续跑状态文件路径。记录每个游戏 uploaded/completed，供 npm start -- --resume 使用。
RUN_STATE_PATH=./.run-state.json

# ===== 排期日期自动生成（gen-schedule）=====
# npm run gen-schedule 自动填充日期时的起始日（YYYY-MM-DD）。
# 留空则取「运行日次日」（运营周二跑 → 周三起连续 7 天）。也可用 --start-date 命令行覆盖。
SCHEDULE_START_DATE=

# ===== 飞书（Lark）运行结果通知 =====
# 运行结束后把本次批处理汇总（成功/失败、失败明细、日志路径）推送到飞书群。
# 在群里添加「自定义机器人」后复制其 Webhook 地址填到这里。留空则不发通知。
FEISHU_WEBHOOK_URL=
# 若机器人开启了「签名校验」，把签名密钥填这里；未开启则留空。
FEISHU_SIGN_SECRET=
# 发送飞书通知的请求超时（毫秒）。
FEISHU_TIMEOUT_MS=10000
