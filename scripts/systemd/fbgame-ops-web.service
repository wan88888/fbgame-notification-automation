[Unit]
Description=fbgame ops web (5173)
After=network-online.target fbgame-ops-api.service
Wants=fbgame-ops-api.service

[Service]
Type=simple
WorkingDirectory=/home/pp_xnt/fbgame-notification-automation
Environment=PATH=/home/pp_xnt/.nvm/versions/node/v24.18.0/bin:/home/pp_xnt/.local/bin:/usr/bin:/bin
ExecStart=/home/pp_xnt/.nvm/versions/node/v24.18.0/bin/npm run ops:web
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
