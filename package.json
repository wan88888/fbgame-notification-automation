{
  "name": "fbgame-notification-automation",
  "version": "1.0.0",
  "description": "Automate Meta (Facebook) game admin 'Send players notifications' workflow using Playwright + AdsPower.",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "gen-schedule": "tsx src/gen-schedule.ts",
    "check-campaigns": "tsx src/check-campaigns.ts",
    "fix-content-csv": "tsx src/fix-content-csv.ts",
    "relabel": "tsx src/relabel.ts",
    "ops:api": "npm --prefix apps/api run start",
    "ops:web": "npm --prefix apps/web run dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "build": "tsc"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "playwright",
    "adspower",
    "automation",
    "meta",
    "facebook-game"
  ],
  "license": "MIT",
  "dependencies": {
    "csv-parse": "^7.0.1",
    "dotenv": "^16.4.5",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.7.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true
  }
}
